PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_delivery_db?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Cấu hình VietQR & Ngân hàng nhận tiền
BANK_ID=MB
BANK_ACCOUNT_NO=0000123456789
BANK_ACCOUNT_NAME=NGUYEN VAN A

# Cấu hình SePay Webhook
SEPAY_API_KEY=

# Cloudinary (image upload) - copy "API environment variable" from https://console.cloudinary.com > Settings > API Keys
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
